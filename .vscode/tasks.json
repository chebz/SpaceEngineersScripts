{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-mp_base",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "Scripts/ModularPrinter/ModularPrinter.sln",
                "--configuration",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile",
            "detail": "Build the ModularPrinter base Space Engineers script"
        },
        {
            "label": "build-mpp_1",
            "type": "shell",
            "command": "dotnet",
            "args": [
