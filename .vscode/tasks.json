                "build-mpp_1",
                "build-mpp_2"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile",
            "detail": "Build all ModularPrinter Space Engineers scripts"
        },
